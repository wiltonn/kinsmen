---
import type { PriceList } from '../lib/content/types';
import { formatPrice } from '../lib/format';
import ReviewFlag from './ReviewFlag.astro';

interface Props {
  list: PriceList;
  headingLevel?: 'h2' | 'h3';
}
const { list, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
---

<div>
  <Heading class="text-2xl font-semibold">{list.title}</Heading>
  <ReviewFlag item={list} class="mt-2" />
  {list.intro && <p class="mt-2 text-bark-700">{list.intro}</p>}
  <table class="mt-4 w-full border-collapse text-left">
    <caption class="sr-only">{list.title}</caption>
    <thead class="sr-only">
      <tr><th scope="col">Option</th><th scope="col">Price</th></tr>
    </thead>
    <tbody>
      {
        list.items.map((item) => (
          <tr class="border-b border-cream-300 last:border-b-0">
            <th scope="row" class="py-3 pr-4 align-top font-normal">
              <span class="font-semibold">{item.label}</span>
              {item.description && <span class="block text-sm text-bark-600">{item.description}</span>}
            </th>
            <td class="py-3 text-right align-top font-semibold whitespace-nowrap tabular-nums">{formatPrice(item.price)}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
  {list.footnote && <p class="mt-3 text-base text-bark-700">{list.footnote}</p>}
</div>
