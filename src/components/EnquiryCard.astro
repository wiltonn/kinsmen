---
/**
 * One enquiry route (school tours, volunteering, membership...). A route
 * without a verified destination is not shown to visitors at all.
 */
import type { EnquiryRoute } from '../lib/content/types';
import { getSiteState } from '../lib/site';

interface Props {
  route: EnquiryRoute;
  headingLevel?: 'h2' | 'h3';
  variant?: 'primary' | 'secondary';
}
const { route, headingLevel = 'h3', variant = 'secondary' } = Astro.props;
const { showDevNotes } = await getSiteState();
const Heading = headingLevel;
const host = route.external && route.href ? new URL(route.href).hostname.replace(/^www\./, '') : undefined;
---

{
  route.href ? (
    <div class="card flex h-full flex-col">
      <Heading class="text-2xl font-semibold">{route.label}</Heading>
      <p class="mt-2 flex-1 text-smoke-700">{route.description}</p>
      <p class="mt-5">
        <a href={route.href} class:list={['btn', variant === 'primary' ? 'btn-primary' : 'btn-secondary']} rel={route.external ? 'noopener' : undefined}>
          {route.actionLabel}
          {host && <span class="sr-only">(goes to {host})</span>}
        </a>
      </p>
      {host === 'docs.google.com' && <p class="mt-3 text-sm text-smoke-600">Opens a Google Form.</p>}
    </div>
  ) : (
    showDevNotes && (
      <div class="card border-2 border-dashed border-alert-700">
        <Heading class="text-2xl font-semibold">{route.label}</Heading>
        <p class="mt-2 font-semibold text-alert-700">
          Development notice: no destination is configured for this enquiry route, so it is hidden on the live site.
        </p>
      </div>
    )
  )
}
