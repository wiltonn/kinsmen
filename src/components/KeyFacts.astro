---
/**
 * The essential visitor facts, all rendered from the shared season and
 * settings records so they stay consistent across pages.
 */
import { getSiteState } from '../lib/site';
import { formatHours, formatPrice } from '../lib/format';
import { expandDateBlocks, formatMonthDay } from '../lib/time';
import { getPancakeHouseDates } from '../lib/season';

const { content, seasonView, reservationView } = await getSiteState();
const { season, settings } = content;
const contact = settings.contact;

const dates =
  seasonView.firstDate && seasonView.lastDate
    ? `${formatMonthDay(seasonView.firstDate)} – ${formatMonthDay(seasonView.lastDate)}, ${season?.year}`
    : 'To be announced';
const publicDays = season ? expandDateBlocks(season.operatingDates).length : 0;
const datesDetail = publicDays ? `${publicDays} public days — see the full list` : undefined;

const hours = season?.operatingHours ? formatHours(season.operatingHours) : 'To be confirmed';

const paidPrices = (season?.admission?.items ?? []).map((i) => i.price).filter((p): p is number => typeof p === 'number');
const admission = paidPrices.length ? `From ${formatPrice(Math.min(...paidPrices))}` : 'To be announced';

const pancakeDates = getPancakeHouseDates(season);
const pancake = reservationView.canBook
  ? 'Reservations open'
  : reservationView.state === 'openingSoon'
    ? 'Reservations opening soon'
    : pancakeDates?.length
      ? 'Dates announced'
      : 'Details to be announced';

const facts = [
  { term: 'When', value: dates, detail: datesDetail, href: '/visit#dates' },
  { term: 'Hours', value: hours, detail: season?.operatingHours?.note, href: '/visit#dates' },
  { term: 'Admission', value: admission, detail: undefined, href: '/visit#prices' },
  { term: 'Pancake House', value: pancake, detail: 'Tables reserved on OpenTable', href: '/pancake-house#reserve' },
  { term: 'Where', value: `${contact.locality}, Ontario`, detail: contact.addressLines.join(', '), href: '/visit#directions' },
];
---

<dl class="grid gap-px overflow-hidden rounded-2xl bg-paper-300 ring-1 ring-paper-300 sm:grid-cols-2 lg:grid-cols-5">
  {
    facts.map((fact) => (
      <div class="relative bg-paper-50 p-5">
        <dt class="font-sans text-sm font-bold tracking-wide text-kin-600 uppercase">{fact.term}</dt>
        <dd class="mt-1">
          <a href={fact.href} class="font-display text-xl leading-snug font-semibold text-ink no-underline after:absolute after:inset-0 hover:underline">
            {fact.value}
          </a>
          {fact.detail && <span class="mt-1 block text-base text-smoke-600">{fact.detail}</span>}
        </dd>
      </div>
    ))
  }
</dl>
