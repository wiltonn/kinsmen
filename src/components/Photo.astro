---
/**
 * Responsive photo. Local images are optimised by Astro (AVIF/WebP + widths);
 * Sanity images use the Sanity CDN srcset. When no photo exists, a decorative
 * pattern is shown instead of a stock image, labelled "Photo needed" in previews.
 */
import { Picture } from 'astro:assets';
import type { SiteImage } from '../lib/content/types';
import { getSiteState } from '../lib/site';

interface Props {
  image?: SiteImage;
  sizes: string;
  class?: string;
  /** Load immediately (only for the main above-the-fold image). */
  priority?: boolean;
  /** Describe the missing photo, for the placeholder label. */
  placeholderLabel?: string;
  /** Aspect-ratio utility class, e.g. "aspect-square". Ignored with `fill`. */
  aspect?: string;
  /** Fill the nearest positioned ancestor (for background-style photos). */
  fill?: boolean;
  showCredit?: boolean;
}

const {
  image,
  sizes,
  class: className,
  priority = false,
  placeholderLabel,
  aspect = 'aspect-[4/3]',
  fill = false,
  showCredit = false,
} = Astro.props;
const frame = fill ? 'absolute inset-0' : `relative ${aspect}`;
const { showDevNotes } = await getSiteState();
const loading = priority ? 'eager' : 'lazy';
const fetchpriority = priority ? 'high' : undefined;
---

{
  image ? (
    <figure class:list={['overflow-hidden', frame, className]}>
      {image.kind === 'local' ? (
        <Picture
          src={image.asset}
          alt={image.alt}
          widths={[480, 800, 1200, 1600, 2000].filter((w) => w <= image.asset.width)}
          sizes={sizes}
          formats={['avif', 'webp']}
          loading={loading}
          fetchpriority={fetchpriority}
          class="h-full w-full object-cover"
        />
      ) : (
        <img
          src={image.url}
          srcset={image.srcset}
          sizes={sizes}
          width={image.width}
          height={image.height}
          alt={image.alt}
          loading={loading}
          fetchpriority={fetchpriority}
          decoding="async"
          class="h-full w-full object-cover"
        />
      )}
      {showCredit && image.credit && (
        <figcaption class="absolute right-2 bottom-2 rounded bg-ink/70 px-2 py-0.5 font-sans text-xs text-white">
          Photo: {image.credit}
        </figcaption>
      )}
      {showDevNotes && image.provenance && image.provenance !== 'confirmed' && (
        <p class="absolute right-2 bottom-2 left-2 rounded border border-dashed border-kin-700 bg-kin-50/95 px-2 py-1 font-sans text-xs font-semibold text-kin-800">
          Needs review · {image.reviewNote}
        </p>
      )}
    </figure>
  ) : (
    <div
      class:list={[
        'flex items-center justify-center overflow-hidden bg-plum-900 bg-[radial-gradient(circle_at_20%_20%,#5a2d84_0,transparent_45%),radial-gradient(circle_at_80%_70%,#b0141a_0,transparent_40%)]',
        frame,
        className,
      ]}
      aria-hidden={showDevNotes ? undefined : 'true'}
    >
      {showDevNotes && (
        <p class="m-4 rounded border border-dashed border-paper-50 px-3 py-2 text-center font-sans text-sm font-semibold text-paper-50">
          Development placeholder — photo needed{placeholderLabel ? `: ${placeholderLabel}` : ''}
        </p>
      )}
    </div>
  )
}
