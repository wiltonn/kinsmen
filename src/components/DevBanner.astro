---
/** Shown on every non-production build so previews are never mistaken for the live site. */
import { getSiteState } from '../lib/site';
const { content } = await getSiteState();
---

<aside class="bg-plum-800 font-sans text-sm text-paper-50 on-dark" aria-label="Preview notice">
  <div class="container-page flex flex-wrap items-center gap-x-4 gap-y-1 py-2">
    <strong>Preview build — not the live website.</strong>
    <span>
      Content source: {content.source === 'fixtures' ? 'development fixtures (unconfirmed)' : 'Sanity'}.
    </span>
    <a href="/dev/content-review" class="text-kin-100 hover:text-white">Content needing review</a>
  </div>
</aside>
