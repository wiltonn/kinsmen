---
interface Props {
  eyebrow?: string;
  title: string;
  id?: string;
  intro?: string;
  level?: 'h2' | 'h3';
  class?: string;
}
const { eyebrow, title, id, intro, level = 'h2', class: className } = Astro.props;
const Heading = level;
---

<div class:list={['max-w-3xl', className]}>
  {eyebrow && <p class="eyebrow mb-2">{eyebrow}</p>}
  <Heading id={id} class="text-3xl font-semibold sm:text-4xl">{title}</Heading>
  {intro && <p class="mt-4 text-lg text-smoke-700">{intro}</p>}
</div>
