---
/** Site mark: a stylised maple leaf. Decorative — always pair it with text. */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg viewBox="0 0 100 100" aria-hidden="true" focusable="false" class={className}>
  <circle cx="50" cy="50" r="50" fill="#1d4030"></circle>
  <path d="M50 6 56 22 66 16 63 36 78 28 74 40 90 38 80 52 84 56 64 66 66 74 53 70 53 94 47 94 47 70 34 74 36 66 16 56 20 52 10 38 26 40 22 28 37 36 34 16 44 22Z" fill="#eeb359" transform="translate(13 12) scale(0.74)"></path>
</svg>
