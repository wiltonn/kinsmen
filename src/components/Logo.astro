---
/**
 * Kin Canada / Kinsmen Club of Greater London logo, taken from the previous
 * website's header artwork (converted to transparent PNGs).
 * Replace with official vector artwork from Kin Canada when available.
 *
 * - `lockup`: emblem + "Kin Canada · Kinsmen Club of Greater London"
 * - `emblem`: the Kin emblem only (small spaces)
 */
import { Image } from 'astro:assets';
import lockupRed from '../assets/brand/kin-lockup-red.png';
import lockupWhite from '../assets/brand/kin-lockup-white.png';
import emblemRed from '../assets/brand/kin-emblem-red.png';
import emblemWhite from '../assets/brand/kin-emblem-white.png';

interface Props {
  variant?: 'lockup' | 'emblem';
  tone?: 'red' | 'white';
  /** Rendered height in CSS pixels. */
  height: number;
  class?: string;
  /** Empty when adjacent text already names the club. */
  alt?: string;
  priority?: boolean;
}

const { variant = 'lockup', tone = 'red', height, class: className, alt, priority = false } = Astro.props;
const src = {
  lockup: { red: lockupRed, white: lockupWhite },
  emblem: { red: emblemRed, white: emblemWhite },
}[variant][tone];
const width = Math.round((src.width / src.height) * height);
const label = alt ?? (variant === 'lockup' ? 'Kin Canada — Kinsmen Club of Greater London' : 'Kin Canada');
---

<Image
  src={src}
  alt={label}
  width={width}
  height={height}
  densities={[1, 2]}
  format="webp"
  loading={priority ? 'eager' : 'lazy'}
  class={className}
/>
