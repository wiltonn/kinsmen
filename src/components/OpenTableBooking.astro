---
/**
 * OpenTableBooking — the only place the site hands visitors to OpenTable.
 *
 * - Booking link: the exact OpenTable URL from the account administrator.
 * - Optional official widget: loaded only when this component is on the page,
 *   only once per page, and only when scrolled near (no third-party script
 *   otherwise). The direct link stays visible as a fallback.
 * - Unconfigured: a clearly labelled development notice; visitors in
 *   production see contact details instead. Never a fake form.
 *
 * No booking details are collected or stored by this website.
 * Setup: docs/opentable-setup.md
 */
import type { ResolvedBooking } from '../lib/opentable';
import type { ReservationView } from '../lib/season';

interface Props {
  booking: ResolvedBooking;
  reservation: ReservationView;
  contact: { phone: string; phoneHref: string; email?: string };
  /** Show configuration notices (non-production builds only). */
  showDevNotes?: boolean;
  /** Heading level for the section title. */
  headingLevel?: 'h2' | 'h3';
  id?: string;
}

const { booking, reservation, contact, showDevNotes = false, headingLevel = 'h2', id = 'reserve' } = Astro.props;
const Heading = headingLevel;
const headingId = `${id}-heading`;
const { canBook } = reservation;
const widget = canBook ? booking.widget : undefined;
const bookingUrl = canBook ? booking.bookingUrl : undefined;
const bookingHost = bookingUrl ? new URL(bookingUrl).hostname.replace(/^www\./, '') : undefined;
const showConfigNotice = showDevNotes && (!booking.configured || booking.issues.length > 0);
---

<section id={id} aria-labelledby={headingId} class="scroll-mt-28 rounded-[var(--radius-card)] bg-forest-900 p-6 text-cream-50 on-dark sm:p-10">
  <p class="eyebrow !text-maple-100">Pancake House reservations</p>
  <Heading id={headingId} class="mt-2 text-3xl font-semibold !text-white sm:text-4xl">{reservation.headline}</Heading>
  <p class="mt-3 max-w-2xl text-lg text-cream-100">{reservation.message}</p>

  {
    canBook && (
      <div class="mt-6 grid gap-6">
        {widget && (
          <div
            class="ot-slot relative w-full max-w-3xl overflow-hidden rounded-2xl bg-white text-ink"
            style={`min-height: ${widget.minHeight}px`}
            data-ot-widget
            data-src={widget.src}
            data-fallback={
              bookingUrl
                ? 'The OpenTable booking widget didn’t load. Please use the “Reserve on OpenTable” button.'
                : `The OpenTable booking widget didn’t load. Please call ${contact.phone} to reserve.`
            }
          >
            <p class="absolute inset-0 flex items-center justify-center p-6 text-center text-bark-700" data-ot-status>
              Loading OpenTable booking…
            </p>
            <noscript>
              <p class="p-6 text-center text-bark-700">
                The booking widget needs JavaScript. {bookingUrl ? 'Use the “Reserve on OpenTable” button instead.' : `Please call ${contact.phone}.`}
              </p>
            </noscript>
          </div>
        )}
        {bookingUrl && (
          <p class="flex flex-wrap items-center gap-4">
            <a href={bookingUrl} class="btn btn-light" rel="noopener">
              Reserve on OpenTable
              <svg aria-hidden="true" viewBox="0 0 20 20" class="h-4 w-4"><path fill="currentColor" d="M11 3h6v6h-2V6.4l-6.3 6.3-1.4-1.4L13.6 5H11V3ZM4 5h5v2H5v8h8v-4h2v6H3V5h1Z" /></svg>
              <span class="sr-only">(goes to {bookingHost})</span>
            </a>
            {widget && <span class="text-base text-cream-100">Prefer a full page? Book directly on OpenTable.</span>}
          </p>
        )}
        <p class="text-base text-cream-100">
          Reservations are made and managed on OpenTable, which shows the dates and times available. This website
          doesn’t collect or store your booking details. To change or cancel, use the link in your OpenTable confirmation.
        </p>
      </div>
    )
  }

  {
    !canBook && reservation.misconfigured && (
      <p class="mt-6">
        <a href={contact.phoneHref} class="btn btn-light">Call {contact.phone}</a>
      </p>
    )
  }

  <p class="mt-6 text-base text-cream-100">
    Questions about your visit? Call <a href={contact.phoneHref} class="font-semibold !text-white">{contact.phone}</a>{contact.email ? ' or email ' : ''}{contact.email && <a href={`mailto:${contact.email}`} class="font-semibold break-all !text-white">{contact.email}</a>}.
  </p>

  {
    showConfigNotice && (
      <div class="mt-6 rounded-xl border-2 border-dashed border-maple-300 bg-forest-800 p-4 font-sans text-base" role="note" data-ot-dev-notice>
        <p class="font-bold text-maple-100">Development notice — OpenTable {booking.configured ? 'configuration warnings' : 'not configured'}</p>
        {!booking.configured && (
          <p class="mt-1">
            No OpenTable booking URL or widget has been set. Add the values supplied by the OpenTable account administrator
            in Sanity → <em>Booking settings</em> (see <code>docs/opentable-setup.md</code>). Until then, visitors see contact
            details only — never a simulated booking form.
          </p>
        )}
        {booking.issues.length > 0 && (
          <ul class="mt-2 list-disc pl-5">
            {booking.issues.map((issue) => <li>{issue}</li>)}
          </ul>
        )}
        <p class="mt-1 text-cream-100">Current reservation state: <strong>{reservation.state}</strong>. This notice is hidden on the production site.</p>
      </div>
    )
  }
</section>

<script>
  /**
   * Loads OpenTable's official widget script into each slot once, when the
   * slot nears the viewport. If it fails, the direct booking link remains.
   */
  const LOAD_TIMEOUT_MS = 15000;
  const w = window as typeof window & { __kfsbOpenTable?: Set<string> };
  const loaded = (w.__kfsbOpenTable ??= new Set<string>());

  function setStatus(slot: HTMLElement, text: string | null) {
    const status = slot.querySelector<HTMLElement>('[data-ot-status]');
    if (!status) return;
    if (text === null) status.remove();
    else status.textContent = text;
  }

  function load(slot: HTMLElement) {
    const src = slot.dataset.src;
    if (!src || slot.hasAttribute('data-ot-initialized')) return;
    slot.setAttribute('data-ot-initialized', '');
    // One widget instance per configuration per page.
    if (loaded.has(src)) {
      setStatus(slot, null);
      return;
    }
    loaded.add(src);

    const failed = () => setStatus(slot, slot.dataset.fallback ?? 'The OpenTable booking widget didn’t load.');
    const observer = new MutationObserver(() => {
      if (slot.querySelector('iframe')) {
        setStatus(slot, null);
        observer.disconnect();
      }
    });
    observer.observe(slot, { childList: true, subtree: true });
    window.setTimeout(() => {
      if (!slot.querySelector('iframe')) failed();
      observer.disconnect();
    }, LOAD_TIMEOUT_MS);

    const script = document.createElement('script');
    script.src = src;
    script.async = true;
    script.addEventListener('error', failed);
    slot.appendChild(script);
  }

  const slots = [...document.querySelectorAll<HTMLElement>('[data-ot-widget]')];
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            io.unobserve(entry.target);
            load(entry.target as HTMLElement);
          }
        }
      },
      { rootMargin: '300px 0px' },
    );
    slots.forEach((slot) => io.observe(slot));
  } else {
    slots.forEach(load);
  }
</script>
