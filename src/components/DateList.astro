---
/**
 * Season dates as an accessible list. Today's date is highlighted client-side.
 *
 * - audience "public": red accent; `layout="tiles"` gives large date cards (homepage).
 * - audience "school": purple accent, one row per week ("Feb 23 & 25 · Tue & Thu").
 */
import type { DateBlock } from '../lib/content/types';
import {
  dateRangeLabelForScreenReaders,
  formatDateRange,
  formatMonthDay,
  formatWeekday,
  formatWeekdayRange,
  groupByWeek,
} from '../lib/time';

interface Props {
  dates: DateBlock[];
  /** Accessible name for the list. */
  label: string;
  audience: 'public' | 'school';
  layout?: 'list' | 'tiles';
}
const { dates, label, audience, layout = 'list' } = Astro.props;
const school = audience === 'school';
const accent = school ? 'border-plum-700' : 'border-kin-500';

/** "Feb 23 & 25" or "Feb 26 & Mar 2" */
const joinDays = (blocks: DateBlock[]) => {
  const parts = blocks.map((b, i) => {
    const prev = blocks[i - 1];
    return prev && prev.startDate.slice(0, 7) === b.startDate.slice(0, 7) ? String(Number(b.startDate.slice(8, 10))) : formatMonthDay(b.startDate);
  });
  return parts.length > 1 ? `${parts.slice(0, -1).join(', ')} & ${parts.at(-1)}` : parts[0];
};
const weeks = school ? groupByWeek(dates) : [];
---

{
  school ? (
    <ul class:list={['divide-y divide-paper-300 overflow-hidden rounded-2xl border-l-4 bg-paper-50 ring-1 ring-paper-300', accent]} aria-label={label}>
      {weeks.map((week) => (
        <li class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 px-5 py-3.5">
          <span class="font-semibold text-ink">
            <span aria-hidden="true">{joinDays(week.blocks)}</span>
            {week.blocks.map((b) => (
              <span data-date-start={b.startDate} data-date-end={b.endDate ?? b.startDate}>
                <time datetime={b.startDate} class="sr-only">{dateRangeLabelForScreenReaders(b)}</time>
                <span data-today-marker hidden class="ml-2 rounded-full bg-plum-700 px-2 py-0.5 text-xs font-semibold text-white">
                  Today
                </span>
              </span>
            ))}
          </span>
          <span class="text-smoke-600" aria-hidden="true">{week.blocks.map((b) => formatWeekday(b.startDate)).join(' & ')}</span>
        </li>
      ))}
    </ul>
  ) : layout === 'tiles' ? (
    <ul class="grid grid-cols-2 gap-3 lg:grid-cols-3" aria-label={label}>
      {dates.map((block) => (
        <li
          class:list={['rounded-2xl border-t-4 bg-paper-50 p-4 ring-1 ring-paper-300 data-[today]:ring-2 data-[today]:ring-kin-500 sm:p-5', accent]}
          data-date-start={block.startDate}
          data-date-end={block.endDate ?? block.startDate}
        >
          <time datetime={block.startDate} class="block">
            <span class="block font-display text-xl font-semibold text-ink sm:text-2xl" aria-hidden="true">{formatDateRange(block)}</span>
            <span class="mt-0.5 block text-smoke-600" aria-hidden="true">{formatWeekdayRange(block)}</span>
            <span class="sr-only">{dateRangeLabelForScreenReaders(block)}</span>
          </time>
          <span class="mt-3 flex flex-wrap gap-2">
            {block.label && <span class="rounded-full bg-kin-100 px-2.5 py-0.5 text-sm font-semibold text-kin-800">{block.label}</span>}
            <span data-today-marker hidden class="rounded-full bg-kin-700 px-2.5 py-0.5 text-sm font-semibold text-white">Today</span>
          </span>
          {block.note && <span class="mt-2 block text-sm text-smoke-600">{block.note}</span>}
        </li>
      ))}
    </ul>
  ) : (
    <ul class:list={['divide-y divide-paper-300 overflow-hidden rounded-2xl border-l-4 bg-paper-50 ring-1 ring-paper-300', accent]} aria-label={label}>
      {dates.map((block) => (
        <li
          class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 px-5 py-3.5 data-[today]:bg-kin-50"
          data-date-start={block.startDate}
          data-date-end={block.endDate ?? block.startDate}
        >
          <span class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
            <time datetime={block.startDate} class="font-semibold text-ink">
              <span aria-hidden="true">{formatDateRange(block)}</span>
              <span class="sr-only">{dateRangeLabelForScreenReaders(block)}</span>
            </time>
            {block.label && <span class="rounded-full bg-kin-100 px-2.5 py-0.5 text-sm font-semibold text-kin-800">{block.label}</span>}
            <span data-today-marker hidden class="rounded-full bg-kin-700 px-2.5 py-0.5 text-sm font-semibold text-white">Today</span>
          </span>
          <span class="text-smoke-600" aria-hidden="true">{formatWeekdayRange(block)}</span>
          {block.note && <span class="w-full text-sm text-smoke-600">{block.note}</span>}
        </li>
      ))}
    </ul>
  )
}
