---
import BaseLayout from '../layouts/BaseLayout.astro';
import Photo from '../components/Photo.astro';
import SeasonStatus from '../components/SeasonStatus.astro';
import KeyFacts from '../components/KeyFacts.astro';
import SectionHeading from '../components/SectionHeading.astro';
import FaqList from '../components/FaqList.astro';
import ReviewFlag from '../components/ReviewFlag.astro';
import JsonLd from '../components/JsonLd.astro';
import LegacyAnchors from '../components/LegacyAnchors.astro';
import { getSiteState } from '../lib/site';
import { getConfig } from '../lib/config';
import { formatMonthDay } from '../lib/time';
import { getPancakeHouseDates } from '../lib/season';

const state = await getSiteState();
const { content, reservationView, seasonView } = state;
const { settings, season, images, experiences, organizations } = content;
const contact = settings.contact;
const config = getConfig();

const upcomingSchoolDates = (season?.schoolTours?.dates ?? []).filter((d) => (d.endDate ?? d.startDate) >= seasonView.today);
const pancakeDates = getPancakeHouseDates(season);
const homeFaqs = [...(season?.faqs ?? []), ...content.generalFaqs.filter((f) => f.provenance !== 'sample')].slice(0, 3);

// Structured data only from confirmed contact details.
const placeLd =
  contact.provenance === 'confirmed'
    ? {
        '@context': 'https://schema.org',
        '@type': 'TouristAttraction',
        name: settings.siteName,
        description: settings.description,
        url: config.siteUrl,
        telephone: contact.phone,
        email: contact.email,
        address: {
          '@type': 'PostalAddress',
          streetAddress: contact.addressLines.join(', '),
          addressLocality: contact.locality,
          addressRegion: contact.region,
          postalCode: contact.postalCode,
          addressCountry: 'CA',
        },
        sameAs: settings.facebookUrl ? [settings.facebookUrl] : undefined,
      }
    : undefined;
---

<BaseLayout
  title="Maple syrup tours and Pancake House near London, Ontario"
  description="Visit the Kinsmen Fanshawe Sugar Bush near Thorndale, Ontario: season dates, the Pancake House, school tours and pure maple syrup — run by Kinsmen volunteers."
>
  <LegacyAnchors slot="head" />
  {placeLd && <JsonLd slot="head" data={placeLd} />}

  <!-- 1. Introduction -->
  <section class="relative isolate overflow-hidden bg-forest-900 on-dark" aria-labelledby="hero-title">
    <Photo
      image={images.hero}
      sizes="100vw"
      priority
      fill
      class="-z-10 opacity-55"
      placeholderLabel="hero"
    />
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-forest-900 via-forest-900/80 to-forest-900/20" aria-hidden="true"></div>
    <div class="container-page py-20 sm:py-28 lg:py-32">
      <p class="eyebrow !text-maple-100">Thorndale · Thames Centre · near London, Ontario</p>
      <h1 id="hero-title" class="mt-3 max-w-3xl text-4xl font-semibold !text-white sm:text-6xl">
        Maple season in the woods by Fanshawe Lake
      </h1>
      <p class="mt-6 max-w-2xl text-xl text-cream-100">
        Walk our sugar bush, see how sap becomes syrup, and sit down to pancakes with pure maple syrup. Run by
        volunteers of the {settings.organizationName}.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/visit" class="btn btn-light">Plan your visit</a>
        {
          reservationView.canBook ? (
            <a href="/pancake-house#reserve" class="btn btn-primary">Reserve a table</a>
          ) : (
            <a href="/pancake-house" class="btn btn-outline-light">Pancake House</a>
          )
        }
      </div>
    </div>
  </section>

  <!-- 2. Season status and essentials -->
  <section aria-labelledby="essentials-title" class="container-page -mt-10 relative">
    <h2 id="essentials-title" class="sr-only">Season status and visitor essentials</h2>
    <div class="rounded-[var(--radius-card)] bg-cream-50 p-6 shadow-xl ring-1 ring-cream-300 sm:p-8">
      <SeasonStatus />
      <div class="mt-6">
        <KeyFacts />
      </div>
    </div>
  </section>

  <!-- 3. Pancake House -->
  <section aria-labelledby="pancake-title" class="container-page mt-20 grid items-center gap-10 lg:grid-cols-2">
    <Photo image={images.pancakeHouse} sizes="(min-width: 1024px) 560px, 100vw" class="rounded-[var(--radius-card)]" placeholderLabel="Pancake House" />
    <div>
      <SectionHeading eyebrow="Pancake House" title="Pancakes with pure maple syrup" id="pancake-title" />
      <p class="mt-4 text-lg text-bark-700">
        Our Pancake House serves pancakes, sausages and hot drinks during the season.
        {season?.menu && <> See the <a href="/pancake-house#menu">menu and prices</a>.</>}
      </p>
      <div class="mt-6 rounded-2xl bg-maple-50 p-5 ring-1 ring-maple-100">
        <p class="font-semibold text-forest-900">{reservationView.headline}</p>
        <p class="mt-1 text-bark-700">{reservationView.message}</p>
        {
          season?.reservations.tourRelationship !== 'unconfirmed' && season?.reservations.tourRelationshipNote && (
            <p class="mt-3 text-base text-bark-700">{season.reservations.tourRelationshipNote}</p>
          )
        }
        {!pancakeDates && <p class="mt-3 text-base text-bark-700">Pancake House dates and serving hours will be posted once confirmed.</p>}
      </div>
      <p class="mt-6 flex flex-wrap gap-3">
        {reservationView.canBook && <a href="/pancake-house#reserve" class="btn btn-primary">Reserve a table</a>}
        <a href="/pancake-house" class="btn btn-secondary">Menu and dining details</a>
      </p>
    </div>
  </section>

  <!-- 4. Sugar Bush experience -->
  <section aria-labelledby="experience-title" class="mt-20 bg-cream-200/70 py-20">
    <div class="container-page grid gap-10 lg:grid-cols-[1fr_1.1fr] lg:items-start">
      <div>
        <SectionHeading
          eyebrow="The Sugar Bush"
          title="A morning in the maple woods"
          id="experience-title"
          intro="Something for every age, from the trail to the sugar shack."
        />
        <Photo image={images.experience} sizes="(min-width: 1024px) 520px, 100vw" class="mt-8 rounded-[var(--radius-card)]" aspect="aspect-square" />
      </div>
      <ul class="grid gap-4">
        {
          experiences.map((item) => (
            <li class="card">
              <h3 class="text-2xl font-semibold">{item.title}</h3>
              <p class="mt-2 text-bark-700">{item.body}</p>
              {item.bookingNote && <p class="mt-2 font-semibold text-forest-700">{item.bookingNote}</p>}
              <ReviewFlag item={item} class="mt-3" />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 5. School and group tours -->
  <section aria-labelledby="school-title" class="container-page mt-20 grid gap-10 lg:grid-cols-2 lg:items-center">
    <div class="lg:order-2">
      <Photo image={images.schoolTours} sizes="(min-width: 1024px) 560px, 100vw" class="rounded-[var(--radius-card)]" />
    </div>
    <div>
      <SectionHeading
        eyebrow="School and group tours"
        title="A field trip students remember"
        id="school-title"
        intro={season?.schoolTours?.intro}
      />
      {
        upcomingSchoolDates.length > 0 && (
          <p class="mt-4 text-lg">
            <strong>{season?.year} school tour days:</strong>{' '}
            {upcomingSchoolDates.map((d) => formatMonthDay(d.startDate)).join(', ')}.
          </p>
        )
      }
      <p class="mt-6 flex flex-wrap gap-3">
        <a href="/school-group-tours" class="btn btn-primary">School tour details</a>
        {season?.schoolTours?.downloads[0] && <a href={season.schoolTours.downloads[0].url} class="btn btn-secondary">Teacher’s guide (PDF)</a>}
      </p>
    </div>
  </section>

  <!-- 6. Community -->
  <section aria-labelledby="community-title" class="mt-20 bg-forest-900 py-20 text-cream-100 on-dark">
    <div class="container-page grid gap-10 lg:grid-cols-[1.2fr_1fr] lg:items-center">
      <div>
        <p class="eyebrow !text-maple-100">About the Kinsmen</p>
        <h2 id="community-title" class="mt-2 text-3xl font-semibold !text-white sm:text-4xl">Your visit supports our community</h2>
        <p class="mt-4 text-lg">
          The Sugar Bush is the main fundraising project of the {settings.organizationName}. Volunteers run it every
          season, and what we raise goes back into the community.
        </p>
        {
          organizations.length > 0 && (
            <>
              <p class="mt-6 font-semibold text-white">Organizations we have supported include:</p>
              <ul class="mt-3 flex flex-wrap gap-2">
                {organizations.slice(0, 6).map((o) => (
                  <li class="rounded-full bg-forest-800 px-3 py-1 text-base ring-1 ring-forest-700">{o.name}</li>
                ))}
              </ul>
            </>
          )
        }
        <p class="mt-8 flex flex-wrap gap-3">
          <a href="/kinsmen/community-impact" class="btn btn-light">Our community impact</a>
          <a href="/kinsmen/get-involved" class="btn btn-outline-light">Volunteer or join</a>
        </p>
      </div>
      <Photo image={images.community} sizes="(min-width: 1024px) 440px, 100vw" class="rounded-[var(--radius-card)]" aspect="aspect-square" />
    </div>
  </section>

  <!-- 7. Directions and practical FAQs -->
  <section aria-labelledby="directions-title" class="container-page mt-20 grid gap-10 lg:grid-cols-2">
    <div>
      <SectionHeading eyebrow="Getting here" title="Find the Sugar Bush" id="directions-title" />
      <address class="mt-5 text-lg not-italic">
        <strong class="block">{settings.siteName}</strong>
        {contact.addressLines.map((l) => <span class="block">{l}</span>)}
        <span class="block">{contact.locality}, {contact.region} {contact.postalCode}</span>
      </address>
      {contact.directions?.map((p) => <p class="mt-3 text-bark-700">{p}</p>)}
      <ReviewFlag item={contact} class="mt-3" />
      <p class="mt-6 flex flex-wrap gap-3">
        {contact.mapUrl && <a href={contact.mapUrl} class="btn btn-secondary" rel="noopener">Open in Google Maps</a>}
        <a href={contact.phoneHref} class="btn btn-secondary">Call {contact.phone}</a>
      </p>
    </div>
    <div>
      <h2 class="text-3xl font-semibold sm:text-4xl">Good to know</h2>
      <div class="mt-5"><FaqList faqs={homeFaqs} /></div>
      <p class="mt-4"><a href="/faq" class="font-semibold">All visitor questions</a></p>
    </div>
  </section>
</BaseLayout>
