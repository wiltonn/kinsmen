---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionHeading from '../components/SectionHeading.astro';
import OpenTableBooking from '../components/OpenTableBooking.astro';
import MenuSection from '../components/MenuSection.astro';
import DateList from '../components/DateList.astro';
import FaqList from '../components/FaqList.astro';
import ReviewFlag from '../components/ReviewFlag.astro';
import Photo from '../components/Photo.astro';
import { getSiteState } from '../lib/site';
import { getPancakeHouseDates } from '../lib/season';
import { formatHours } from '../lib/format';

const { content, booking, reservationView, showDevNotes } = await getSiteState();
const { season, settings, images } = content;
const contact = settings.contact;
const dates = getPancakeHouseDates(season);
const tour = season?.reservations;
const faqs = [...(season?.faqs ?? []), ...content.generalFaqs].filter((f) => f.topic === 'pancakeHouse');
---

<BaseLayout
  title="Pancake House: menu and reservations"
  description="Pancakes with pure maple syrup at the Kinsmen Fanshawe Sugar Bush Pancake House. See the menu and prices, and reserve a table on OpenTable."
>
  <PageHeader
    eyebrow="Visit the Sugar Bush"
    title="Pancake House"
    intro="Pancakes with pure maple syrup, served by volunteers at the Sugar Bush."
  />

  <div class="container-page mt-14 grid gap-16">
    <div class="grid gap-10 lg:grid-cols-[1.4fr_1fr] lg:items-start">
      <OpenTableBooking
        booking={booking}
        reservation={reservationView}
        contact={{ phone: contact.phone, phoneHref: contact.phoneHref, email: contact.email }}
        showDevNotes={showDevNotes}
      />
      <Photo image={images.pancakeHouse} sizes="(min-width: 1024px) 420px, 100vw" class="rounded-[var(--radius-card)]" placeholderLabel="Pancake House interior or a plate of pancakes" />
    </div>

    <section aria-labelledby="tours-and-reservations" class="card max-w-3xl">
      <h2 id="tours-and-reservations" class="text-3xl font-semibold">Does a reservation include a tour?</h2>
      {
        tour?.tourRelationship === 'separate' && (
          <p class="mt-3 text-lg">
            <strong>No — they’re separate.</strong> {tour.tourRelationshipNote}
          </p>
        )
      }
      {
        tour?.tourRelationship === 'included' && (
          <p class="mt-3 text-lg">
            <strong>Yes.</strong> {tour.tourRelationshipNote}
          </p>
        )
      }
      {
        (!tour || tour.tourRelationship === 'unconfirmed') && (
          <p class="mt-3 text-lg">
            We’re confirming how Pancake House reservations and Sugar Bush tours work together this season. Please
            call <a href={contact.phoneHref}>{contact.phone}</a> if you need to know before you visit.
          </p>
        )
      }
      {
        showDevNotes && (tour?.tourRelationship === 'unconfirmed' || season?.provenance !== 'confirmed') && (
          <p class="mt-3">
            <ReviewFlag
              item={{
                provenance: 'needsReview',
                reviewNote:
                  'REQUIRED CONTENT DECISION: confirm whether a table reservation includes a tour or admission. Set “Reservation and tours” on the season in Sanity.',
              }}
            />
          </p>
        )
      }
    </section>

    <section aria-labelledby="pancake-dates" class="grid gap-8 lg:grid-cols-2">
      <div>
        <SectionHeading title="Dates and serving hours" id="pancake-dates" />
        <p class="mt-4 text-lg text-smoke-700">
          {
            season?.pancakeHouse.servingHours
              ? `Serving ${formatHours(season.pancakeHouse.servingHours)}.`
              : 'Serving hours will be posted once confirmed.'
          }
          {season?.pancakeHouse.servingHours?.note && ` ${season.pancakeHouse.servingHours.note}`}
        </p>
        {season?.pancakeHouse.note && <p class="mt-3 text-smoke-700">{season.pancakeHouse.note}</p>}
        {
          season?.pancakeHouse.dateMode === 'sameAsOperating' && (
            <p class="mt-3 text-smoke-700">The Pancake House is open on every <a href="/visit#dates">public day</a>.</p>
          )
        }
      </div>
      <div>
        {
          dates?.length ? (
            <DateList dates={dates} label={`${season?.year} Pancake House dates`} year={season?.year} />
          ) : (
            <p class="card text-lg">
              Pancake House dates for {season?.year ?? 'the next season'} haven’t been announced yet.
              <ReviewFlag item={{ provenance: 'needsReview', reviewNote: 'Pancake House dates were not published on the old site. Choose “Same as public dates” or add custom dates.' }} class="mt-2" />
            </p>
          )
        }
      </div>
    </section>

    <section aria-labelledby="menu">
      <SectionHeading title={season?.menu?.title ?? 'Menu'} id="menu" />
      {
        season?.menu ? (
          <div class="mt-4"><MenuSection menu={season.menu} /></div>
        ) : (
          <p class="mt-4 text-lg text-smoke-700">This season’s menu will be posted soon.</p>
        )
      }
      <p class="mt-6 text-smoke-700">
        Taking some syrup home? See <a href="/maple-products">maple products and prices</a>.
      </p>
    </section>

    {
      faqs.length > 0 && (
        <section aria-labelledby="pancake-questions">
          <SectionHeading title="Questions" id="pancake-questions" />
          <div class="mt-6 max-w-3xl"><FaqList faqs={faqs} /></div>
        </section>
      )
    }
  </div>
</BaseLayout>
