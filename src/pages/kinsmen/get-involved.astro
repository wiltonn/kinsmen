---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import EnquiryCard from '../../components/EnquiryCard.astro';
import ReviewFlag from '../../components/ReviewFlag.astro';
import Photo from '../../components/Photo.astro';
import { getSiteState } from '../../lib/site';

const { content } = await getSiteState();
const { kinsmen, settings, images } = content;
const { volunteering, membership } = settings.enquiries;
const sharedForm = volunteering.href && volunteering.href === membership.href;
const crumbs = [{ name: 'About the Kinsmen', href: '/kinsmen' }];
---

<BaseLayout
  title="Volunteer or become a member"
  description="Volunteer at the Kinsmen Fanshawe Sugar Bush — including volunteer hours for high school students — or find out about joining the Kinsmen Club of Greater London."
  breadcrumbs={crumbs}
>
  <PageHeader
    eyebrow="About the Kinsmen"
    title="Volunteer or become a member"
    intro={volunteering.description}
    breadcrumbs={crumbs}
  >
    <nav aria-label="On this page" class="mt-6 flex flex-wrap gap-3">
      <a href="#volunteer" class="btn btn-secondary">Volunteering</a>
      <a href="#membership" class="btn btn-secondary">Membership</a>
    </nav>
  </PageHeader>

  <div class="container-page mt-14 grid gap-20">
    <section aria-labelledby="volunteer" class="grid gap-10 lg:grid-cols-[1.2fr_1fr] lg:items-start">
      <div>
        <SectionHeading eyebrow="Volunteering" title="Lend a hand at the Sugar Bush" id="volunteer" />
        <ReviewFlag item={kinsmen.volunteering} class="mt-3" />
        {kinsmen.volunteering.intro.map((p) => <p class="mt-4 text-lg text-smoke-700">{p}</p>)}
        <ul class="mt-8 grid gap-4 sm:grid-cols-3 lg:grid-cols-1 xl:grid-cols-3">
          {
            kinsmen.volunteering.reasons.map((r) => (
              <li class="rounded-2xl bg-kin-50 p-5 ring-1 ring-kin-100">
                <h3 class="font-sans text-lg font-bold">{r.title}</h3>
                <p class="mt-1 text-base text-smoke-700">{r.body}</p>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="grid gap-6">
        <Photo image={images.volunteers} sizes="(min-width: 1024px) 460px, 100vw" class="rounded-[var(--radius-card)]" />
        <EnquiryCard route={volunteering} variant="primary" />
      </div>
    </section>

    <section aria-labelledby="membership" class="grid gap-10 lg:grid-cols-[1.2fr_1fr] lg:items-start">
      <div>
        <SectionHeading eyebrow="Membership" title="Join the Kinsmen Club of Greater London" id="membership" />
        <ReviewFlag item={kinsmen.membership} class="mt-3" />
        {kinsmen.membership.intro.map((p) => <p class="mt-4 text-lg text-smoke-700">{p}</p>)}
        {
          kinsmen.membership.steps.length > 0 && (
            <ol class="mt-6 grid gap-4">
              {kinsmen.membership.steps.map((step, i) => (
                <li class="flex gap-4">
                  <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-plum-900 font-bold text-white" aria-hidden="true">
                    {i + 1}
                  </span>
                  <span class="pt-1.5 text-lg">{step}</span>
                </li>
              ))}
            </ol>
          )
        }
      </div>
      <div class="grid gap-4">
        <EnquiryCard route={membership} variant="primary" />
        {
          sharedForm && (
            <p class="text-base text-smoke-700">
              Volunteering and membership use the same short interest form. Tick the options that interest you and a
              club member will get in touch.
            </p>
          )
        }
      </div>
    </section>
  </div>
</BaseLayout>
