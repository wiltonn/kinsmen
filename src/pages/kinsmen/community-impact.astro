---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import ReviewFlag from '../../components/ReviewFlag.astro';
import Photo from '../../components/Photo.astro';
import { getSiteState } from '../../lib/site';

const { content } = await getSiteState();
const { stories, organizations, settings } = content;
const crumbs = [{ name: 'About the Kinsmen', href: '/kinsmen' }];
---

<BaseLayout
  title="Community impact"
  description="Money raised at the Kinsmen Fanshawe Sugar Bush supports local and national causes. See the organizations the Kinsmen Club of Greater London has helped."
  breadcrumbs={crumbs}
>
  <PageHeader
    eyebrow="About the Kinsmen"
    title="Community impact"
    intro={`Every pancake and every bottle of syrup helps the ${settings.organizationName} serve our community’s greatest need.`}
    breadcrumbs={crumbs}
  />

  <div class="container-page mt-14 grid gap-16">
    {
      stories.length > 0 && (
        <section aria-labelledby="stories">
          <SectionHeading title="Stories from our club" id="stories" />
          <div class="mt-8 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
            {stories.map((story) => (
              <article class="card flex flex-col overflow-hidden !p-0">
                {story.image && <Photo image={story.image} sizes="(min-width: 1024px) 360px, (min-width: 768px) 50vw, 100vw" />}
                <div class="flex-1 p-6">
                  <h3 class="text-2xl font-semibold">{story.title}</h3>
                  {story.bodyHtml ? (
                    <div class="prose-site mt-3 text-smoke-700" set:html={story.bodyHtml} />
                  ) : (
                    <div class="prose-site mt-3 text-smoke-700">{story.body.map((p) => <p>{p}</p>)}</div>
                  )}
                  <ReviewFlag item={story} class="mt-3" />
                </div>
              </article>
            ))}
          </div>
        </section>
      )
    }

    {
      organizations.length > 0 && (
        <section aria-labelledby="organizations">
          <SectionHeading
            title="Organizations we support"
            id="organizations"
            intro="Funds raised by our club have supported these organizations."
          />
          <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {organizations.map((org) => (
              <li class="card">
                <h3 class="font-sans text-xl font-bold">
                  {org.url ? <a href={org.url} rel="noopener">{org.name}</a> : org.name}
                </h3>
                {org.description && <p class="mt-2 text-smoke-700">{org.description}</p>}
                <ReviewFlag item={org} class="mt-3" />
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section aria-labelledby="impact-help" class="rounded-[var(--radius-card)] bg-plum-800 p-8 text-paper-100 on-dark sm:p-12">
      <h2 id="impact-help" class="text-3xl font-semibold !text-white">Want to help?</h2>
      <p class="mt-3 max-w-2xl text-lg">Visit the Sugar Bush, buy our syrup, or give your time as a volunteer.</p>
      <p class="mt-6 flex flex-wrap gap-3">
        <a href="/visit" class="btn btn-light">Plan a visit</a>
        <a href="/kinsmen/get-involved" class="btn btn-outline-light">Volunteer or join</a>
      </p>
    </section>
  </div>
</BaseLayout>
