---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionHeading from '../components/SectionHeading.astro';
import EnquiryCard from '../components/EnquiryCard.astro';
import ReviewFlag from '../components/ReviewFlag.astro';
import { getSiteState } from '../lib/site';

const { content, reservationView } = await getSiteState();
const { settings } = content;
const c = settings.contact;
const e = settings.enquiries;
---

<BaseLayout
  title="Contact us"
  description="Contact the Kinsmen Fanshawe Sugar Bush: phone, email and address, plus the right place for Pancake House reservations, school tours, volunteering and membership."
>
  <PageHeader eyebrow="Contact" title="Contact us" intro="Choose the option that fits your question so it reaches the right volunteers." />

  <div class="container-page mt-14 grid gap-16">
    <section aria-labelledby="enquiry-routes">
      <h2 id="enquiry-routes" class="sr-only">Ways to reach us</h2>
      <div class="grid gap-6 md:grid-cols-2">
        <div class="card flex h-full flex-col">
          <h3 class="text-2xl font-semibold">Pancake House reservations</h3>
          <p class="mt-2 flex-1 text-smoke-700">
            Tables are reserved through OpenTable, not by email. {reservationView.message}
          </p>
          <p class="mt-5"><a href="/pancake-house#reserve" class="btn btn-primary">Pancake House reservations</a></p>
        </div>
        <EnquiryCard route={e.schoolTours} />
        <EnquiryCard route={e.volunteering} />
        <EnquiryCard route={e.membership} />
        <EnquiryCard route={e.general} />
      </div>
    </section>

    <section aria-labelledby="contact-details" class="grid gap-8 md:grid-cols-2">
      <div>
        <SectionHeading title="Contact details" id="contact-details" />
        <ReviewFlag item={c} class="mt-3" />
        <dl class="mt-6 grid gap-5 text-lg">
          <div>
            <dt class="font-semibold">Phone</dt>
            <dd><a href={c.phoneHref}>{c.phone}</a></dd>
          </div>
          <div>
            <dt class="font-semibold">Email</dt>
            <dd><a href={`mailto:${c.email}`} class="break-all">{c.email}</a></dd>
          </div>
          <div>
            <dt class="font-semibold">Address</dt>
            <dd>
              <address class="not-italic">
                {settings.siteName}<br />
                {c.addressLines.map((l) => <>{l}<br /></>)}
                {c.locality}, {c.region} {c.postalCode}
              </address>
              {c.mapUrl && <a href={c.mapUrl} rel="noopener" class="mt-1 inline-block">Directions in Google Maps</a>}
            </dd>
          </div>
          {
            settings.facebookUrl && (
              <div>
                <dt class="font-semibold">Facebook</dt>
                <dd><a href={settings.facebookUrl} rel="noopener">Kinsmen Fanshawe Sugar Bush on Facebook</a></dd>
              </div>
            )
          }
        </dl>
      </div>
      <div class="card self-start">
        <h2 class="text-2xl font-semibold">Before you get in touch</h2>
        <ul class="mt-4 grid gap-2 text-smoke-700">
          <li><a href="/visit#dates">Season dates and hours</a></li>
          <li><a href="/faq">Visitor questions</a></li>
          <li><a href="/school-group-tours">School tour dates and pricing</a></li>
        </ul>
      </div>
    </section>
  </div>
</BaseLayout>
