# Copy to .env for local development. Never commit real secrets.

# Canonical public URL of the production site (no trailing slash).
PUBLIC_SITE_URL=https://www.kinsmenfanshawesugarbush.com

# "production" ONLY on the live production deployment. Anything else
# (development, preview, staging) is treated as non-production:
# pages get <meta name="robots" content="noindex"> and robots.txt disallows all.
SITE_ENV=development

# Where content comes from: "sanity" or "fixtures".
# Defaults to "sanity" when SANITY_PROJECT_ID is set, otherwise "fixtures".
# Production builds refuse to use fixtures.
CONTENT_SOURCE=

# Sanity (public project ID and dataset — not secrets).
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_VERSION=2026-10-01
# Only required if the dataset is private. Use a read-only "Viewer" token.
SANITY_READ_TOKEN=

# Fixture-mode only: test the OpenTable integration locally without Sanity.
# Use the exact values supplied by the OpenTable account administrator.
# Ignored when CONTENT_SOURCE=sanity (Sanity's "Booking settings" is the source of truth).
FIXTURE_OPENTABLE_BOOKING_URL=
FIXTURE_OPENTABLE_WIDGET_LOADER_URL=
