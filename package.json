{
  "name": "kinsmen-fanshawe-sugar-bush",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Website for the Kinsmen Fanshawe Sugar Bush and the Kinsmen Club of Greater London",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/check-links.mjs && node scripts/check-private-data.mjs",
    "preview": "astro preview",
    "check": "astro check && tsc -p workspace",
    "test": "vitest run",
    "verify": "npm run check && npm run test && npm run build",
    "admin:demo": "npm run admin:demo --prefix studio",
    "workspace:demo": "node --disable-warning=ExperimentalWarning workspace/dev-server.ts",
    "db:migrate": "node scripts/db-migrate.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.1",
    "@neon/config": "^1.14.0",
    "@neon/env": "^2.1.3",
    "@portabletext/to-html": "^6.0.0",
    "@recogito/text-annotator": "^4.3.7",
    "@sanity/client": "^8.10.1",
    "@sanity/image-url": "^2.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vercel/functions": "^3.11.2",
    "astro": "^7.4.2",
    "pg": "^8.23.1",
    "sql.js": "^1.13.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/pg": "^8.23.1",
    "@types/sql.js": "^1.4.11",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
