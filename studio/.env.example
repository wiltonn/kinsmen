# Copy to .env for local Studio development. These are public identifiers.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production
# Subdomain for `npm run deploy` -> https://<host>.sanity.studio
SANITY_STUDIO_HOST=
# Website Admin tracker tool (docs/spikes/admin-tracker.md). Leave empty until set up.
SANITY_STUDIO_ADMIN_TRACKER=
# Preview site origin, so the tool can link /dev/content-review.
SANITY_STUDIO_PREVIEW_URL=
